{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/compass/ibis_node.schema.json",
  "title": "IBIS Graph Node",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "node_type", "content"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "node_type": {
      "type": "string",
      "enum": ["issue", "position", "argument", "resolution"]
    },
    "content": {
      "type": "string",
      "maxLength": 2000
    },
    "parent_id": {
      "type": ["string", "null"],
      "maxLength": 64
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    }
  }
}
